# ============================================================
# صورة العامل المستقل فقط (بلا واجهة ولا PyTorch/camel)
# تشغيل: docker run -e DATABASE_URL=… -e LLM_API_KEY=… istishraf-worker
# ============================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

COPY backend/requirements-worker.txt ./backend/requirements-worker.txt

# الاعتماديات المطلوبة للعامل فقط: Flask (دالة المصنع والخدمات)، OpenAI، Zep،
# معالجة الملفات، وpsycopg للطابور الدائم — بلا PyTorch ولا camel.
RUN pip install --no-cache-dir -r backend/requirements-worker.txt

COPY backend ./backend
COPY locales ./locales

RUN mkdir -p /app/backend/uploads /app/backend/logs

WORKDIR /app/backend

# نفس أمر التشغيل على أي مستضيف دائم
CMD ["python", "-m", "app.worker"]
