# ============================================================
# صورة العامل المستقل فقط (بلا واجهة ولا PyTorch/camel)
# تشغيل: docker run -e DATABASE_URL=… -e LLM_API_KEY=… istishraf-worker
# ============================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

# الاعتماديات المطلوبة للعامل فقط: Flask (لاستخدام دالة المصنع والخدمات)،
# OpenAI، Zep، معالجة الملفات، وpsycopg للطابور الدائم.
RUN pip install --no-cache-dir \
    "flask>=3.0.0" \
    "flask-cors>=6.0.0" \
    "openai>=1.0.0" \
    "zep-cloud==3.25.0" \
    "httpx>=0.27.0" \
    "PyMuPDF>=1.24.0" \
    "charset-normalizer>=3.0.0" \
    "chardet>=5.0.0" \
    "python-dotenv>=1.0.0" \
    "pydantic>=2.0.0" \
    "psycopg[binary]>=3.1" \
    "psycopg_pool>=3.2"

COPY backend ./backend
COPY locales ./locales

RUN mkdir -p /app/backend/uploads /app/backend/logs

WORKDIR /app/backend

# نفس أمر التشغيل على أي مستضيف دائم
CMD ["python", "-m", "app.worker"]
